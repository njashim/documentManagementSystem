@page "/documents"
@using System.Text.Json
@inject HttpClient Http
@attribute [StreamRendering]

<PageTitle>Documents</PageTitle>

<h1>Documents</h1>

<p>This component demonstrates showing data.</p>

@if (documents == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var document in documents)
            {
                <tr>
                    <td>@document.Id</td>
                    <td>
                        @if (document.IsEditing)
                        {
                            <input type="text" class="form-control" @bind="@document.EditName" />
                        }
                        else
                        {
                            @document.Name
                        }
                    </td>
                    <td>
                        @if (document.IsEditing)
                        {
                            <button class="btn btn-success" @onclick="() => SaveEdit(document)">Save</button>
                            <button class="btn btn-secondary" @onclick="() => CancelEdit(document)">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="() => EditDocument(document)">Edit</button>
                            <button class="btn btn-danger" @onclick="() => DeleteDocument(document.Id)">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h3>Add New Document</h3>
<div>
    <label for="documentName">Document Name:</label>
    <input type="text" id="documentName" class="form-control" @bind="newDocumentName" />

    <label for="fileUpload">Upload File:</label>
    <InputFile id="fileUpload" OnChange="OnFileSelectedAsync" />

    <button class="btn btn-primary" @onclick="SaveNewDocument">Save</button>
</div>

@code {
    private Document[]? documents;
    private const string ApiBaseUrl = "http://dms_api/";
    private string newDocumentName = string.Empty;
    private IBrowserFile? selectedFile;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        try
        {
            var apiUrl = $"{ApiBaseUrl}documents";
            var jsonResponse = await Http.GetStringAsync(apiUrl);
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            using var jsonDoc = JsonDocument.Parse(jsonResponse);
            var documentList = jsonDoc.RootElement.Deserialize<List<Document>>(options);

            documents = documentList?.ToArray();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Fehler beim Laden der Dokumente: {ex.Message}");
        }
    }

    private async Task DeleteDocument(Guid documentId)
    {
        try
        {
            var apiUrl = $"{ApiBaseUrl}documents/{documentId}";
            var response = await Http.DeleteAsync(apiUrl);

            if (response.IsSuccessStatusCode)
            {
                // Entferne das gelöschte Dokument aus der Liste
                documents = documents?.Where(d => d.Id != documentId).ToArray();
            }
            else
            {
                Console.Error.WriteLine($"Fehler beim Löschen des Dokuments: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Fehler beim Löschen des Dokuments: {ex.Message}");
        }
    }

    private void EditDocument(Document document)
    {
        document.IsEditing = true;
        document.EditName = document.Name;
    }

    private void CancelEdit(Document document)
    {
        document.IsEditing = false;
        document.EditName = null;
    }

    private async Task SaveEdit(Document document)
    {
        if (string.IsNullOrWhiteSpace(document.EditName))
        {
            Console.Error.WriteLine("Der Name darf nicht leer sein.");
            return;
        }

        try
        {
            var content = new StringContent(JsonSerializer.Serialize(new { Id = document.Id, Name = document.EditName }), System.Text.Encoding.UTF8, "application/json");

            var apiUrl = $"{ApiBaseUrl}documents/{document.Id}";
            var response = await Http.PutAsync(apiUrl, content);

            if (response.IsSuccessStatusCode)
            {
                document.Name = document.EditName;
                document.IsEditing = false;
                document.EditName = null;
            }
            else
            {
                var errorDetails = await response.Content.ReadAsStringAsync();
                Console.Error.WriteLine($"Fehler beim Aktualisieren des Dokuments: {response.ReasonPhrase} - Details: {errorDetails}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Fehler beim Aktualisieren des Dokuments: {ex.Message}");
        }
    }

    private async Task SaveNewDocument()
    {
        // Sicherstellen, dass der Name und die Datei ausgewählt sind
        if (string.IsNullOrWhiteSpace(newDocumentName) || selectedFile == null)
        {
            Console.Error.WriteLine("Bitte füllen Sie alle Felder aus.");
            return;
        }

        try
        {
            // Die Datei in Base64 umwandeln
            var fileBytes = new byte[selectedFile.Size];
            await selectedFile.OpenReadStream().ReadAsync(fileBytes);
            var base64File = Convert.ToBase64String(fileBytes);

            // Das Dokument als JSON erstellen
            var documentModel = new DocumentModel
                {
                    Name = newDocumentName,
                    FileBase64 = base64File,
                    FileName = selectedFile.Name
                };

            // Die POST-Anforderung mit den Dokumentdaten senden
            var apiUrl = $"{ApiBaseUrl}documents";
            var jsonContent = new StringContent(JsonSerializer.Serialize(documentModel), System.Text.Encoding.UTF8, "application/json");
            var response = await Http.PostAsync(apiUrl, jsonContent);

            if (response.IsSuccessStatusCode)
            {
                // Lade die Dokumente neu, nachdem ein neues Dokument hinzugefügt wurde
                await LoadDocuments();
                newDocumentName = string.Empty;
                selectedFile = null;
            }
            else
            {
                var errorDetails = await response.Content.ReadAsStringAsync();
                Console.Error.WriteLine($"Fehler beim Hochladen des Dokuments: {response.ReasonPhrase} - Details: {errorDetails}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Fehler beim Speichern des Dokuments: {ex.Message}");
        }
    }

    // Asynchrone Methode für die Dateiauswahl
    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file != null)
        {
            selectedFile = file;
            Console.WriteLine($"Datei ausgewählt: {selectedFile.Name}, Größe: {selectedFile.Size}, Typ: {selectedFile.ContentType}");
        }
        else
        {
            Console.WriteLine("Keine Datei ausgewählt oder ungültiger Dateityp.");
        }
    }

    private class Document
    {
        public Guid Id { get; set; }
        public string Name { get; set; }
        public bool IsEditing { get; set; } = false;
        public string? EditName { get; set; }
    }

    private class DocumentModel
    {
        public string Name { get; set; }
        public string FileBase64 { get; set; }
        public string FileName { get; set; }
    }
}
