@page "/documents"
@attribute [StreamRendering]

@inject IConfiguration Configuration
@inject HttpClient Http

<PageTitle>Documents</PageTitle>

<style>
    .input-container {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .input-container .form-group {
            margin-bottom: 0;
            flex: 1;
        }

        .input-container button {
            margin-left: 10px;
        }
</style>

<h1>Documents</h1>

<p>This component demonstrates showing data.</p>

@if (documents == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Tags</th>
                <th>Content</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var document in documents)
            {
                <tr>
                    <td>@document.Id</td>
                    <td>@document.Name</td>
                    <td>
                        @if (document.IsEditing)
                        {
                            <input type="text" class="form-control" @bind="@document.EditTags" />
                        }
                        else
                        {
                            @document.Tags
                        }
                    </td>
                    <td>@document.Content</td>
                    <td>
                        @if (document.IsEditing)
                        {
                            <button class="btn btn-success" @onclick="() => SaveEdit(document)">Save</button>
                            <button class="btn btn-secondary" @onclick="() => CancelEdit(document)">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="() => EditDocument(document)">Edit</button>
                            <button class="btn btn-danger" @onclick="() => DeleteDocument(document.Id)">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h3>Upload Document</h3>
<div class="input-container">
    <div class="form-group">
        <label for="documentTags">Document Tags:</label>
        <input type="text" id="documentTags" class="form-control" @bind="newDocumentTags" />
    </div>
    <div class="form-group">
        <label for="fileUpload">Upload File:</label>
        <InputFile id="fileUpload" OnChange="OnFileSelectedAsync" @key="@fileInputKey" />
    </div>
    <button class="btn btn-primary" @onclick="SaveNewDocument">Save</button>
</div>

@code {
    private Document[]? documents;
    private string ApiBaseUrl => Configuration["ApiSettings:ApiBaseUrl"];
    private string newDocumentTags = string.Empty;
    private IBrowserFile? selectedFile;
    private string fileInputKey = Guid.NewGuid().ToString();

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        try
        {
            documents = await Http.GetFromJsonAsync<Document[]>($"{ApiBaseUrl}/documents");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading documents: {ex.Message}");
            documents = Array.Empty<Document>();
        }
    }

    private async Task DeleteDocument(Guid documentId)
    {
        try
        {
            var response = await Http.DeleteAsync($"{ApiBaseUrl}/documents/{documentId}");

            if (response.IsSuccessStatusCode)
            {
                await LoadDocuments();
            }
            else
            {
                Console.WriteLine($"Failed to delete document with ID {documentId}: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting document: {ex.Message}");
        }
    }

    private void EditDocument(Document document)
    {
        document.IsEditing = true;
        document.EditTags = document.Tags;
    }

    private void CancelEdit(Document document)
    {
        document.IsEditing = false;
        document.EditTags = null;
    }

    private async Task SaveEdit(Document document)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(document.EditTags))
            {
                Console.WriteLine("Error: Document tags cannot be empty.");
                return;
            }

            var updatedDocument = new Document
                {
                    Id = document.Id,
                    Name = document.Name,
                    Tags = document.EditTags
                };

            var response = await Http.PutAsJsonAsync($"{ApiBaseUrl}/documents/{document.Id}", updatedDocument);

            if (response.IsSuccessStatusCode)
            {
                document.Tags = document.EditTags;
                document.IsEditing = false;
                document.EditTags = null;
            }
            else
            {
                Console.WriteLine($"Failed to update document with ID {document.Id}: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving document changes: {ex.Message}");
        }
    }

    private async Task SaveNewDocument()
    {
        if (selectedFile == null)
        {
            Console.WriteLine("Error: No file selected.");
            return;
        }

        try
        {
            var formData = new MultipartFormDataContent();

            // Dateiinhalt als Byte-Array in FormData hinzufügen
            var fileContent = new StreamContent(selectedFile.OpenReadStream());
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);
            formData.Add(fileContent, "file", selectedFile.Name);

            // Zusätzliche Felder korrekt hinzufügen
            formData.Add(new StringContent(Guid.NewGuid().ToString()), "Id");
            formData.Add(new StringContent(selectedFile.Name), "Name");
            formData.Add(new StringContent(newDocumentTags ?? string.Empty), "Tags");

            // API-Aufruf
            var response = await Http.PostAsync($"{ApiBaseUrl}/documents", formData);

            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine("Document saved successfully.");
                newDocumentTags = string.Empty;
                selectedFile = null;
                fileInputKey = Guid.NewGuid().ToString(); // FileInput zurücksetzen
                await LoadDocuments();
            }
            else
            {
                Console.WriteLine($"Failed to save document: {response.StatusCode}");
                var errorResponse = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error details: {errorResponse}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving document: {ex.Message}");
        }
    }






    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        try
        {
            selectedFile = e.File;

            if (selectedFile != null)
            {
                Console.WriteLine($"Selected file: {selectedFile.Name} ({selectedFile.Size} bytes)");
            }
            else
            {
                Console.WriteLine("No file selected.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error selecting file: {ex.Message}");
        }
    }

    private class Document
    {
        public Guid Id { get; set; }
        public string Name { get; set; }
        public string Tags { get; set; }
        public bool IsEditing { get; set; } = false;
        public string? EditTags { get; set; }
        public byte[] Content { get; set; }
    }
}
